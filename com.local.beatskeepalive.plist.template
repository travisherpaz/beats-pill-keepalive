<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.local.beatskeepalive</string>

    <key>ProgramArguments</key>
    <array>
        <string>/usr/bin/python3</string>
        <string>REPLACE_WITH_ABSOLUTE_PATH_TO/beats_keepalive.py</string>
    </array>

    <key>RunAtLoad</key>
    <true/>

    <key>KeepAlive</key>
    <true/>

    <key>ProcessType</key>
    <string>Background</string>

    <key>Nice</key>
    <integer>10</integer>

    <key>StandardOutPath</key>
    <string>REPLACE_WITH_HOME/Library/Application Support/BeatsKeepAlive/stdout.log</string>

    <key>StandardErrorPath</key>
    <string>REPLACE_WITH_HOME/Library/Application Support/BeatsKeepAlive/stderr.log</string>
</dict>
</plist>
